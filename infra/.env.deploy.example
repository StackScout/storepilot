# Copy this file to .env.deploy (gitignored, see ../.gitignore) and fill
# in real values. Never commit .env.deploy — see infra/README.md.

AWS_REGION=us-east-1
ENVIRONMENT_NAME=storepilot-test

# --- security.yaml / compute.yaml CloudFormation parameters ---
VPC_ID=vpc-xxxxxxxx
SUBNET_ID=subnet-xxxxxxxx
KEY_NAME=your-ec2-keypair-name
SSH_ALLOWED_CIDR=203.0.113.4/32
SSH_KEY_PATH=~/.ssh/your-ec2-keypair.pem

# --- SSM Parameter Store secrets (scripts/put-secrets.sh) ---
DB_USERNAME=storepilot
DB_PASSWORD=change-me
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
SES_SENDER_EMAIL=you@example.com

# --- Platform config (backend bootstrap only — see below) ---
# These are read exactly once, by DataSeeder, to insert the single
# platform_settings row if it doesn't exist yet (see
# backend/.../common/PlatformProperties.kt's doc comment). After that first
# insert, the running app reads that DB row, not these env vars — to
# reconfigure a live deployment, update the platform_settings row directly
# rather than editing this file and restarting. Country content is no
# longer baked into the frontend image at all: the frontend fetches it from
# the backend at runtime (GET /api/platform-config, GET /api/states), so
# there are no NEXT_PUBLIC_PLATFORM_*/CURRENCY_* build args anymore.
#
# Defaults below are Australia's — the near-term deployment target while
# the Sri Lanka launch is on hold pending business registration. A Sri
# Lanka deployment overrides these instead.
PLATFORM_NAME=StorePilot
PLATFORM_TAGLINE="Australia's marketplace for small business sellers"
PLATFORM_COUNTRY_NAME=Australia
PLATFORM_COUNTRY_CODE=AU
PLATFORM_CURRENCY_CODE=AUD
PLATFORM_CURRENCY_SYMBOL=$
PLATFORM_CURRENCY_LOCALE=en-AU
PLATFORM_FEE_PERCENT=3.5
PLATFORM_FLAT_SHIPPING_FEE=1000
PLATFORM_DEFAULT_COD_ENABLED=true
PLATFORM_DEFAULT_ONLINE_PAYMENT_ENABLED=false
PLATFORM_DEFAULT_BANK_TRANSFER_ENABLED=true
SUPPORT_EMAIL=hello@storepilot.au
COMPANY_LOCATION="Sydney, Australia"
# All money values (PLATFORM_FLAT_SHIPPING_FEE above, product prices, etc.)
# are cents, not whole dollars — see backend Product.kt's doc comment.

# --- Cognito (compute.yaml parameters + put-secrets.sh) ---
# Cognito is manually created, not managed by any CFN template here (see
# infra/README.md's auth section), and reused across every country
# deployment rather than recreated per-region — the app just calls it as
# an API, so it doesn't need to live in the same region as the instance.
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Hosted UI + Google federation app client (separate from COGNITO_CLIENT_ID
# above) — domain has no https:// prefix, just the host.
COGNITO_OAUTH_DOMAIN=
COGNITO_OAUTH_CLIENT_ID=
COGNITO_OAUTH_CLIENT_SECRET=

# --- Stripe Connect (Standard accounts, direct charges) ---
# See backend StripeConnectService/StripeService doc comments. Webhook
# secret comes from a Stripe Dashboard endpoint specifically configured to
# listen to *events on connected accounts* — see StripeWebhookService.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Stripe seller Pro-plan billing (platform's own Stripe account, not
# Connect) — see backend SellerBillingService/SellerBillingWebhookService
# doc comments. This is a SEPARATE Stripe Dashboard webhook endpoint from
# STRIPE_WEBHOOK_SECRET above, configured to listen to "Your account"
# events (checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted) pointing at
# https://<your-domain>/api/billing/stripe/webhook — not the connected-
# accounts endpoint. Success/cancel URLs are derived automatically from
# SITE_ADDRESS at instance boot (see compute.yaml), same as
# STRIPE_SUCCESS_URL_BASE/STRIPE_CANCEL_URL_BASE above — nothing to set
# here for those.
STRIPE_BILLING_WEBHOOK_SECRET=

# --- cicd.yaml — GitHub Actions deploy pipeline auth (see infra/README.md's
# CI/CD section and .github/workflows/deploy.yml) ---
GITHUB_ORG=StackScout
GITHUB_REPO=storepilot
# GitHub's numeric, immutable org/repo IDs — the actual OIDC "sub" claim is
# repo:<org>@<org-id>/<repo>@<repo-id>:..., not the plain names (see
# cicd.yaml's GitHubOrgId parameter description for why). Find them with:
# curl -s https://api.github.com/orgs/<org> | grep '"id"'
# curl -s https://api.github.com/repos/<org>/<repo> | grep '"id"'   (first one)
GITHUB_ORG_ID=
GITHUB_REPO_ID=
# IAM's GitHub OIDC provider is a per-AWS-account singleton. Leave true
# unless `aws iam list-open-id-connect-providers` already shows one for
# token.actions.githubusercontent.com (e.g. from another project in this
# account) — then set this false and fill in the ARN below instead.
CREATE_OIDC_PROVIDER=true
EXISTING_OIDC_PROVIDER_ARN=
# No safe default — look this up fresh (don't copy an old value from
# elsewhere). See cicd.yaml's GithubOidcThumbprint parameter description
# for where to find it.
GITHUB_OIDC_THUMBPRINT=

# --- ABR "ABN Lookup" (AbnLookupService) ---
# Free GUID from https://abr.business.gov.au/Tools/WebServices — any email,
# not tied to owning a business. Leave blank to disable ABN verification
# (onboarding/admin just show nothing instead of a lookup result).
ABR_GUID=

# --- Expo push notifications (ExpoPushNotificationService) ---
# Optional access token from https://expo.dev/accounts/[account]/settings/access-tokens
# — restricts push sends to your Expo project. Leave blank and push still
# works (Expo's push API accepts unauthenticated requests), this just stops
# anyone else sending through your project.
EXPO_ACCESS_TOKEN=
