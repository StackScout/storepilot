# Copy this file to .env.deploy (gitignored, see ../.gitignore) and fill
# in real values. Never commit .env.deploy — see infra/README.md.

AWS_REGION=us-east-1
ENVIRONMENT_NAME=islandcart-test

# --- security.yaml / compute.yaml CloudFormation parameters ---
VPC_ID=vpc-xxxxxxxx
SUBNET_ID=subnet-xxxxxxxx
KEY_NAME=your-ec2-keypair-name
SSH_ALLOWED_CIDR=203.0.113.4/32
SSH_KEY_PATH=~/.ssh/your-ec2-keypair.pem

# --- SSM Parameter Store secrets (scripts/put-secrets.sh) ---
DB_USERNAME=islandcart
DB_PASSWORD=change-me
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
SES_SENDER_EMAIL=you@example.com

# --- Platform config (backend bootstrap only — see below) ---
# These are read exactly once, by DataSeeder, to insert the single
# platform_settings row if it doesn't exist yet (see
# backend/.../common/PlatformProperties.kt's doc comment). After that first
# insert, the running app reads that DB row, not these env vars — to
# reconfigure a live deployment, update the platform_settings row directly
# rather than editing this file and restarting. Country content is no
# longer baked into the frontend image at all: the frontend fetches it from
# the backend at runtime (GET /api/platform-config, GET /api/states), so
# there are no NEXT_PUBLIC_PLATFORM_*/CURRENCY_* build args anymore.
#
# Defaults below are Australia's — the near-term deployment target while
# the Sri Lanka launch is on hold pending business registration. A Sri
# Lanka deployment overrides these instead.
PLATFORM_NAME=IslandCart
PLATFORM_TAGLINE=Australia's marketplace for small business sellers
PLATFORM_COUNTRY_NAME=Australia
PLATFORM_COUNTRY_CODE=AU
PLATFORM_CURRENCY_CODE=AUD
PLATFORM_CURRENCY_SYMBOL=$
PLATFORM_CURRENCY_LOCALE=en-AU
PLATFORM_FEE_PERCENT=3.5
PLATFORM_FLAT_SHIPPING_FEE=10
PLATFORM_DEFAULT_COD_ENABLED=true
PLATFORM_DEFAULT_ONLINE_PAYMENT_ENABLED=false
PLATFORM_DEFAULT_BANK_TRANSFER_ENABLED=true
SUPPORT_EMAIL=hello@islandcart.au
COMPANY_LOCATION=Sydney, Australia
# NOT covered by the vars above — needs its own design before this can
# fully serve AU, see PlatformProperties.kt's doc comment: currency decimal
# precision (every amount is a whole-unit Int, no cents, so AUD pricing is
# whole-dollar only).
